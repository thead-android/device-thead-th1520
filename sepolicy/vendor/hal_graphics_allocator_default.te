type dmabuf_cma_heap_device, dmabuf_heap_device_type, dev_type;

# The TH1520 PowerVR gralloc's ION ABI shim allocates scanout-capable buffers
# from the mainline CMA DMA-BUF heap.
allow hal_graphics_allocator_default dmabuf_cma_heap_device:chr_file r_file_perms;

# AIDL front end and original HIDL backend are separate init-managed services
# in this domain. No child-process execute_no_trans exception is needed.
allow hal_graphics_allocator_default self:binder { call transfer };

# The minigbm allocator opens the render node selected by DRM.  LPI4A exposes
# renderD129 when the display controller owns card0, so this cannot be covered
# by the old renderD128-only device label.
allow hal_graphics_allocator_default gpu_device:chr_file {
    getattr
    ioctl
    map
    open
    read
    write
};

# The DDK exports DMA-BUF metadata, not minigbm's reserved-region memfd.
# Do not grant all allocator clients access to allocator-private tmpfs: that
# includes isolated_compute_app and violates the platform isolation contract.
