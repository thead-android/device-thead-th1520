# The legacy same-process gralloc calls ion_open() during client initialization.
# Allocation remains in the allocator service; this rule does NOT add heap ioctl,
# write or mmap permissions to application clients.
allow { surfaceflinger hal_graphics_composer_default bootanim system_server appdomain
        mediacodec mediaswcodec }
    dmabuf_cma_heap_device:chr_file { open read getattr };
