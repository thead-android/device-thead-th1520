vndbinder_use(hal_camera_default);

# For camera hal to talk with gralloc
allow hal_camera_default hal_graphics_mapper_hwservice:hwservice_manager find;
hal_client_domain(hal_camera_default, hal_graphics_allocator);
hal_client_domain(hal_camera_default, hal_graphics_composer);

# For camera device
#allow hal_camera_default camera_device:dir r_dir_perms;
allow hal_camera_default camera_device:chr_file { open read write ioctl map getattr };

# For video device
#allow hal_camera_default video_device:dir r_dir_perms;
allow hal_camera_default video_device:chr_file { open read write ioctl map getattr };

# For gpu device
allow hal_camera_default gpu_device:chr_file { open read write ioctl map getattr };

# For sys_nice
allow hal_camera_default self:global_capability_class_set sys_nice;

# For fence fd
allow surfaceflinger hal_camera_default:fd use;
allow mediaswcodec hal_camera_default:fd use;
allow hal_camera_default mediaserver:fd use;

