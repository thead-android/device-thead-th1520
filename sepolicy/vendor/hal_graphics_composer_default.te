hal_client_domain(hal_graphics_composer_default, hal_graphics_allocator)

allow hal_graphics_composer_default hal_graphics_mapper_service:service_manager find;

#allow hal_graphics_composer_default default_android_service:service_manager add;
#allow hal_graphics_composer_default device:chr_file { ioctl open read write };
allow hal_graphics_composer_default self:netlink_kobject_uevent_socket { bind create read };
#allow hal_graphics_composer_default servicemanager:binder { call transfer };
allow hal_graphics_composer_default vndbinder_device:chr_file { ioctl map open read write };
