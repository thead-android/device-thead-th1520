# Android fstab file.
#<src>                         <mnt_point> <type>       <mnt_flags and options>    <fs_mgr_flags>
/dev/block/by-name/boot        /boot        emmc        defaults                    defaults
system                         /system      ext4        ro,barrier=1                wait,slotselect,avb=vbmeta,logical,first_stage_mount
vendor                         /vendor      ext4        ro,barrier=1                wait,slotselect,logical,first_stage_mount
/dev/block/by-name/userdata    /data        ext4        discard,noatime,nosuid,nodev,noauto_da_alloc,data=ordered,user_xattr,barrier=1  latemount,wait,check,quota,formattable,fileencryption=aes-256-xts:aes-256-cts:inlinecrypt_optimized
/dev/block/by-name/metadata    /metadata    ext4        nodev,noatime,nosuid        wait,formattable,first_stage_mount,check
/dev/block/by-name/misc        /misc        emmc        defaults                    defaults
