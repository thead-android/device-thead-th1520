package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "lpi4a_g2d_hwc_scene",
    srcs: ["g2d_hwc_scene.cpp"],
    shared_libs: ["libgui", "libui", "libbinder", "libutils", "libnativewindow", "liblog"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}

cc_binary {
    name: "lpi4a_g2d_scanout_probe",
    srcs: ["g2d_scanout_probe.c"],
    shared_libs: ["libdrm"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}

cc_library_shared {
    name: "libth1520_g2d",
    vendor_available: true,
    srcs: ["th1520_g2d.c"],
    export_include_dirs: ["include"],
    include_dirs: [
        "external/libdrm/etnaviv",
        "external/libdrm/tests/etnaviv",
    ],
    shared_libs: [
        "libdrm",
        "libdrm_etnaviv",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}

cc_binary {
    name: "th1520_g2d_test",
    vendor: true,
    srcs: ["th1520_g2d_test.c"],
    include_dirs: ["external/libdrm/etnaviv"],
    shared_libs: [
        "libdrm",
        "libdrm_etnaviv",
        "libth1520_g2d",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}
